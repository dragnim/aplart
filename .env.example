# APL Art — build-time configuration.
# Copy to `.env.local` and adjust. No secrets are required to run this project.

# The APL execution endpoint. TryAPL's Exec service sends
# Access-Control-Allow-Origin: * and so can be called directly from the browser.
VITE_APL_EXEC_ENDPOINT=https://tryapl.org/Exec

# Client-side execution timeout, in milliseconds.
VITE_APL_REQUEST_TIMEOUT_MS=8000

# Output limits. See "Matrix output contract" in the README: TryAPL truncates
# its response at 93 lines of 995 characters, so a single request cannot carry
# more than roughly 90 rows. Presets that declare high-resolution output are
# fetched in several banded requests, up to these ceilings.
VITE_MAX_MATRIX_ROWS=256
VITE_MAX_MATRIX_COLUMNS=256
VITE_MAX_MATRIX_CELLS=65536

# Rows and columns available from one request, derived from the measured caps.
VITE_SINGLE_REQUEST_MAX_ROWS=90

# Hard ceiling on submitted code length, in Unicode characters.
VITE_MAX_CODE_LENGTH=10000

# Reject raw responses larger than this, in bytes.
VITE_MAX_RESPONSE_BYTES=2097152

# Override the deployment base path. Defaults to /aplart/ for GitHub Pages.
# VITE_BASE=/
