{
  "name": "apl-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Create patterns, fractals and generative art with Dyalog APL.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dragnim/aplart.git"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "validate:presets": "tsx --import ./scripts/lib/registerRaw.mjs scripts/validate-presets.ts",
    "verify:cors": "node scripts/verify-live-cors.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "refresh:fixtures": "tsx --import ./scripts/lib/registerRaw.mjs scripts/refresh-fixtures.ts",
    "generate:thumbnails": "tsx --import ./scripts/lib/registerRaw.mjs scripts/generate-thumbnails.ts",
    "preset:variants": "tsx --import ./scripts/lib/registerRaw.mjs scripts/preview-variants.ts",
    "preset:sheet": "tsx --import ./scripts/lib/registerRaw.mjs scripts/contact-sheet.ts",
    "preset:debug": "tsx --import ./scripts/lib/registerRaw.mjs scripts/debug-preset.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "benchmark:mandelbrot": "tsx --import ./scripts/lib/registerRaw.mjs scripts/benchmark-mandelbrot.ts",
    "benchmark:report": "tsx --import ./scripts/lib/registerRaw.mjs scripts/report-mandelbrot-benchmark.ts",
    "benchmark:iterations": "tsx --import ./scripts/lib/registerRaw.mjs scripts/benchmark-iterations.ts",
    "benchmark:iterations:report": "tsx --import ./scripts/lib/registerRaw.mjs scripts/report-iteration-benchmark.ts",
    "preset:compare": "tsx --import ./scripts/lib/registerRaw.mjs scripts/palette-compare.ts",
    "prototype:adaptive": "tsx --import ./scripts/lib/registerRaw.mjs scripts/prototype-adaptive.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
